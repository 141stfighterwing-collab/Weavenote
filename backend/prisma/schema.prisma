// Prisma Schema for Weavenote PostgreSQL Database
// A robust SQL database configuration with full relational integrity

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// User Management
// =============================================================================

model User {
  id            String    @id @default(uuid())
  uid           String    @unique
  email         String    @unique
  username      String
  passwordHash  String?
  permission    Permission @default(read)
  status        UserStatus @default(active)
  statusUntil   DateTime?
  role          UserRole   @default(user)
  lastLogin     DateTime   @default(now())
  ipAddress     String?
  country       String?
  countryFlag   String?
  aiUsageCount  Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  notes         Note[]
  folders       Folder[]
  sessions      Session[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([uid])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// Notes & Content
// =============================================================================

model Note {
  id              String        @id @default(uuid())
  title           String
  content         String        @db.Text
  rawContent      String        @db.Text
  category        String
  type            NoteType      @default(quick)
  color           NoteColor     @default(yellow)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  accessCount     Int           @default(0)
  isDeleted       Boolean       @default(false)
  deletedAt       DateTime?
  isSynthesized   Boolean       @default(false)
  wordCount       Int?
  textColor       String?
  backgroundColor String?
  
  // Foreign Keys
  userId          String?
  folderId        String?
  
  // Relations
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder          Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags            NoteTag[]
  attachments     Attachment[]
  projectData     ProjectData?
  
  @@index([userId])
  @@index([folderId])
  @@index([type])
  @@index([category])
  @@index([isDeleted])
  @@index([createdAt])
  @@map("notes")
}

model NoteTag {
  id        String   @id @default(uuid())
  noteId    String
  tag       String
  
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  
  @@unique([noteId, tag])
  @@index([tag])
  @@map("note_tags")
}

model Attachment {
  id          String   @id @default(uuid())
  noteId      String
  filename    String
  mimeType    String
  size        Int
  path        String
  createdAt   DateTime @default(now())
  
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  
  @@index([noteId])
  @@map("attachments")
}

// =============================================================================
// Project Data (for project-type notes)
// =============================================================================

model ProjectData {
  id                  String   @id @default(uuid())
  noteId              String   @unique
  estimatedDuration   String?
  manualProgress      Int?
  isCompleted         Boolean  @default(false)
  
  note                Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  
  objectives          ProjectObjective[]
  deliverables        ProjectDeliverable[]
  milestones          ProjectMilestone[]
  timeline            ProjectPhase[]
  workflowNodes       WorkflowNode[]
  workflowEdges       WorkflowEdge[]
  
  @@map("project_data")
}

model ProjectObjective {
  id              String        @id @default(uuid())
  projectDataId   String
  label           String
  status          ItemStatus    @default(pending)
  order           Int           @default(0)
  
  projectData     ProjectData   @relation(fields: [projectDataId], references: [id], onDelete: Cascade)
  
  @@index([projectDataId])
  @@map("project_objectives")
}

model ProjectDeliverable {
  id              String        @id @default(uuid())
  projectDataId   String
  label           String
  status          ItemStatus    @default(pending)
  order           Int           @default(0)
  
  projectData     ProjectData   @relation(fields: [projectDataId], references: [id], onDelete: Cascade)
  
  @@index([projectDataId])
  @@map("project_deliverables")
}

model ProjectMilestone {
  id              String        @id @default(uuid())
  projectDataId   String
  date            DateTime
  label           String
  status          ItemStatus    @default(pending)
  order           Int           @default(0)
  
  projectData     ProjectData   @relation(fields: [projectDataId], references: [id], onDelete: Cascade)
  
  @@index([projectDataId])
  @@map("project_milestones")
}

model ProjectPhase {
  id              String        @id @default(uuid())
  projectDataId   String
  name            String
  startDate       DateTime
  endDate         DateTime
  order           Int           @default(0)
  
  projectData     ProjectData   @relation(fields: [projectDataId], references: [id], onDelete: Cascade)
  
  @@index([projectDataId])
  @@map("project_phases")
}

model WorkflowNode {
  id              String            @id @default(uuid())
  projectDataId   String
  label           String
  rule            String?
  status          WorkflowStatus    @default(pending)
  nodeId          String            // External node ID for graph
  order           Int               @default(0)
  
  projectData     ProjectData       @relation(fields: [projectDataId], references: [id], onDelete: Cascade)
  
  @@unique([projectDataId, nodeId])
  @@index([projectDataId])
  @@map("workflow_nodes")
}

model WorkflowEdge {
  id              String        @id @default(uuid())
  projectDataId   String
  source          String        // Node ID
  target          String        // Node ID
  order           Int           @default(0)
  
  projectData     ProjectData   @relation(fields: [projectDataId], references: [id], onDelete: Cascade)
  
  @@index([projectDataId])
  @@map("workflow_edges")
}

// =============================================================================
// Folders
// =============================================================================

model Folder {
  id          String   @id @default(uuid())
  name        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Foreign Keys
  userId      String?
  
  // Relations
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes       Note[]
  
  @@index([userId])
  @@map("folders")
}

// =============================================================================
// Templates
// =============================================================================

model Template {
  id              String   @id @default(uuid())
  userId          String?
  title           String
  type            NoteType @default(quick)
  content         String   @db.Text
  workflowSteps   String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@map("templates")
}

// =============================================================================
// System Settings & Environment Variables
// =============================================================================

model SystemSetting {
  id          String          @id @default(uuid())
  key         String          @unique
  value       String          @db.Text
  isSecret    Boolean         @default(true)
  category    SettingCategory @default(general)
  description String?
  updatedBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  @@index([key])
  @@index([category])
  @@map("system_settings")
}

model SystemVersion {
  id              String   @id @default(uuid())
  version         String   @unique
  patchNotes      String?  @db.Text
  appliedAt       DateTime @default(now())
  appliedBy       String?
  isBreaking      Boolean  @default(false)
  requiresRestart Boolean  @default(false)
  status          PatchStatus @default(applied)
  
  @@index([version])
  @@map("system_versions")
}

model VersionHistory {
  id          String   @id @default(uuid())
  versionId   String
  action      String
  details     String?  @db.Text
  createdAt   DateTime @default(now())
  userId      String?
  
  @@index([versionId])
  @@index([createdAt])
  @@map("version_history")
}

// =============================================================================
// Enums
// =============================================================================

enum SettingCategory {
  api
  database
  firebase
  security
  general
}

enum PatchStatus {
  pending
  applied
  rolled_back
  failed
}

enum NoteType {
  quick
  notebook
  deep
  code
  project
  contact
  document
}

enum NoteColor {
  yellow
  blue
  green
  pink
  purple
  orange
  teal
  rose
  indigo
  lime
  sky
  fuchsia
  slate
  red
  cyan
  violet
  matrix
}

enum Permission {
  read
  edit
}

enum UserStatus {
  active
  suspended
  pending
  banned
}

enum UserRole {
  super_admin
  admin
  user
}

enum ItemStatus {
  pending
  completed
}

enum WorkflowStatus {
  pending
  in_progress
  done
}
