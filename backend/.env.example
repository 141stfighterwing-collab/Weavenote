# Backend Environment Configuration
NODE_ENV=production
PORT=3001

# Database
DATABASE_URL=postgresql://weavenote:weavenote_secure_password_change_me@postgres:5432/weavenote?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# AI
GEMINI_API_KEY=your-gemini-api-key-here
ADMIN_SETUP_PASS=your-admin-setup-password

# Security
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
